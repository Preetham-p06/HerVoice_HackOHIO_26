# Local demo: never use real sensitive information.
APP_MODE=demo
NEXT_PUBLIC_APP_MODE=demo
API_URL=http://127.0.0.1:8000
DATA_DIR=.data
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TEXT_PROVIDER=demo
# Set true only for a deliberately local production-build demo.
ALLOW_LOCAL_DEMO=false

# Live server adapter configuration (not required for demo).
# APP_MODE=live
# NEXT_PUBLIC_APP_MODE=live
# DEFAULT_ORG=org_from_clerk
# NEXT_PUBLIC_ORG_NAME=Your participating organization
# MONGODB_URI=
# MONGODB_DATABASE=hervoice
# DATA_ENCRYPTION_KEY=BASE64_32_RANDOM_BYTES
# RECIPIENT_KEYS={"org_from_clerk":"BASE64_32_RANDOM_BYTES"}
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUDIENCE=hervoice
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# TEXT_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=CHOOSE_A_CURRENT_SUPPORTED_MODEL
# IMAGE_PROVIDER=gemini
# GEMINI_IMAGE_MODEL=CHOOSE_A_SUPPORTED_IMAGE_MODEL
# AWS_REGION=us-east-1
# AWS_PROFILE=your_local_profile
# BEDROCK_IMAGE_MODEL=CHOOSE_A_CURRENT_NOVA_CANVAS_MODEL_ID
# S3_PRIVATE_BUCKET=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=CHOOSE_A_SUPPORTED_MODEL
# RHUBARB_PATH=/absolute/path/to/rhubarb
# Live ALLOWED_ORIGINS must contain your exact HTTPS frontend origin.
# Optional semantic matching; explicit indexing sends approved narratives to Gemini.
# MATCH_PROVIDER=atlas
# GEMINI_EMBEDDING_MODEL=CHOOSE_A_SUPPORTED_EMBEDDING_MODEL
# ATLAS_CASE_VECTOR_INDEX=case_similarity
# Optional permitted social-feed API. No network polling occurs without all three.
# Endpoint protocol: docs/hackathon-demo.md. Original PNG bytes must be preserved.
# SOCIAL_FEED_URL=https://your-approved-connector.example/feed
# SOCIAL_FEED_TOKEN=
# SOCIAL_FEED_ORG=org_from_clerk

# OpenAI: one server-only key for text, image, speech and optional embeddings.
# TEXT_PROVIDER=openai
# IMAGE_PROVIDER=openai
# SPEECH_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=nova
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional restricted browser key for the official Google Maps Embed API.
# Without a key, the map uses Google Maps web embedding.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
