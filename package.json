{
  "name": "hervoice",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": ".venv/bin/python -m pytest backend/tests -q",
    "dev:all": ".venv/bin/python backend/scripts/dev.py",
    "contracts": ".venv/bin/python backend/scripts/contracts.py",
    "test:e2e": "playwright test",
    "format": "prettier --write frontend package.json",
    "lint": ".venv/bin/ruff check backend/api backend/tests backend/scripts --select F",
    "demo:start": ".venv/bin/python backend/scripts/demo_service.py start",
    "demo:stop": ".venv/bin/python backend/scripts/demo_service.py stop",
    "demo:status": ".venv/bin/python backend/scripts/demo_service.py status"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.17"
  }
}
